// The kinds of tree, and where each grows (D37).
//
// id:       snake_case, unique; the client finds its images by it.
// height_m: a grown tree, in metres, its true height (the client draws it
//           at the world's scale, D40: about 8 m for a 22 m oak).
// habitats: how much the species grows in each habitat, against the
//           others there (any scale; 0 or absent: none). Habitats:
//           heart, wood, edge, clearing, camp, copse, lone, riverside,
//           cliff_foot, meadow.
//
// big:      a big tree, on the woods' wide grid (8 m), nothing small under
//           its crown; the others on the narrow grid (4 m) between them.
// spread_m: how far its seeds fall from a mother tree, in metres (4 to
//           36): heavy seeds close, in tight groups; light ones far.
// pioneer:  the first to grow back in the woods' openings.
// fruit:    when its fruit shows on the tree (D48): Some((from: (season,
//           hundredths), until: (season, hundredths))), as a crop's in
//           crops.ron (until before from: into the next year). Out of it,
//           or without it, the tree is drawn bare; in it, laden, or as
//           much as is left of its crop when one of crops.ron is in
//           season. The windows below are placeholders, to tune by eye.
// bark:     the material a body cuts from its trunk with an edge in hand
//           (D57), when its bark comes away; absent, cutting gives nothing.
//
// Within a habitat, one kind dominates each stand of a few hundred metres
// (the weight here times a power of its stand's strength at the place;
// only the kinds suited at least half as well as the best compete);
// trees then take the kind of a mother tree near them (D37, D40).
[
    (id: "oak", name: "Oak", height_m: 22.0, big: true, spread_m: 12,
        habitats: { heart: 50, wood: 45, edge: 20, copse: 50, lone: 60 },
        // Acorns.
        fruit: Some((from: (autumn, 0), until: (winter, 0)))),
    (id: "pine", name: "Scots pine", height_m: 25.0, big: true, spread_m: 28,
        habitats: { heart: 15, wood: 15, edge: 5, cliff_foot: 100, lone: 10 },
        // Cones.
        fruit: Some((from: (autumn, 0), until: (winter, 50)))),
    // On the banks too (D37, amended 25 November 2026, the project lead:
    // "Ok, va pour ça"): a pioneer of the river gravels, half the
    // willow's weight there, so it forms its own stands by the water.
    (id: "birch", name: "Birch", height_m: 18.0, spread_m: 34, pioneer: true,
        habitats: { heart: 5, wood: 10, edge: 45, cliff_foot: 20, lone: 35, riverside: 50 },
        // Its bark, cut with an edge (D57).
        bark: Some("birch_bark")),
    (id: "hazel", name: "Hazel", height_m: 5.0, spread_m: 10,
        habitats: { heart: 6, wood: 12, edge: 35, copse: 15, lone: 10 },
        // Hazelnuts.
        fruit: Some((from: (autumn, 0), until: (winter, 0)))),
    (id: "willow", name: "Willow", height_m: 12.0, spread_m: 24,
        habitats: { riverside: 100 }),
    (id: "wild_apple", name: "Wild apple", height_m: 6.0, spread_m: 14,
        habitats: { edge: 5, copse: 40, lone: 40 },
        // Crab apples, as their crop in crops.ron.
        fruit: Some((from: (summer, 70), until: (autumn, 100)))),
    // Added on 9 November 2026 with the flora (content/flora.ron).
    (id: "alder", name: "Alder", height_m: 18.0, spread_m: 22,
        habitats: { riverside: 60, edge: 10 }),
    (id: "ash", name: "Ash", height_m: 28.0, big: true, spread_m: 26,
        habitats: { heart: 15, wood: 30, edge: 25, copse: 20 }),
    (id: "linden", name: "Linden", height_m: 25.0, big: true, spread_m: 18,
        habitats: { heart: 30, wood: 35, copse: 15 }),
    (id: "yew", name: "Yew", height_m: 12.0, spread_m: 12,
        habitats: { heart: 2, wood: 1 },
        // Arils.
        fruit: Some((from: (autumn, 0), until: (autumn, 80)))),
    // Fruit and nut trees (16 November 2026), for the vivarium's food;
    // those without images of their own yet are drawn with a stand-in's
    // (client/world/trees.gd, STAND_INS). Their fruit shows while their
    // crop of crops.ron is in season.
    (id: "wild_cherry", name: "Wild cherry", height_m: 20.0, spread_m: 20,
        habitats: { wood: 10, edge: 25, copse: 20, lone: 15 },
        // Cherries, as their crop in crops.ron.
        fruit: Some((from: (spring, 80), until: (summer, 30)))),
    (id: "mulberry", name: "Mulberry", height_m: 10.0, spread_m: 16,
        habitats: { edge: 10, copse: 15, lone: 20, riverside: 5 },
        // Mulberries.
        fruit: Some((from: (summer, 20), until: (summer, 80)))),
    (id: "wild_pear", name: "Wild pear", height_m: 12.0, spread_m: 14,
        habitats: { edge: 5, copse: 30, lone: 35 },
        // Pears.
        fruit: Some((from: (autumn, 0), until: (autumn, 80)))),
    (id: "walnut", name: "Walnut", height_m: 25.0, big: true, spread_m: 8,
        habitats: { edge: 5, copse: 20, lone: 30, riverside: 10 },
        // Walnuts.
        fruit: Some((from: (autumn, 20), until: (winter, 20)))),
    (id: "chestnut", name: "Sweet chestnut", height_m: 28.0, big: true, spread_m: 8,
        habitats: { wood: 25, edge: 15, copse: 15 },
        // Chestnuts.
        fruit: Some((from: (autumn, 20), until: (winter, 20)))),
    (id: "wild_fig", name: "Wild fig", height_m: 6.0, spread_m: 20,
        habitats: { cliff_foot: 30, lone: 5 },
        // Figs, as their crop in crops.ron.
        fruit: Some((from: (summer, 60), until: (autumn, 50)))),
]
