// The kinds of tree, and where each grows (D37).
//
// id:       snake_case, unique; the client finds its images by it.
// height_m: a grown tree, in metres, its true height (the client draws it
//           at the world's scale, D40: about 8 m for a 22 m oak).
// habitats: how much the species grows in each habitat, against the
//           others there (any scale; 0 or absent: none). Habitats:
//           heart, wood, edge, clearing, camp, copse, lone, riverside,
//           cliff_foot, meadow.
//
// big:      a big tree, on the woods' wide grid (8 m), nothing small under
//           its crown; the others on the narrow grid (4 m) between them.
// spread_m: how far its seeds fall from a mother tree, in metres (4 to
//           36): heavy seeds close, in tight groups; light ones far.
// pioneer:  the first to grow back in the woods' openings.
//
// Within a habitat, one kind dominates each stand of a few hundred metres
// (the weight here times a power of its stand's strength at the place;
// only the kinds suited at least half as well as the best compete);
// trees then take the kind of a mother tree near them (D37, D40).
[
    (id: "oak", name: "Oak", height_m: 22.0, big: true, spread_m: 12,
        habitats: { heart: 50, wood: 45, edge: 20, copse: 50, lone: 60 }),
    (id: "pine", name: "Scots pine", height_m: 25.0, big: true, spread_m: 28,
        habitats: { heart: 15, wood: 15, edge: 5, cliff_foot: 100, lone: 10 }),
    (id: "birch", name: "Birch", height_m: 18.0, spread_m: 34, pioneer: true,
        habitats: { heart: 5, wood: 10, edge: 45, cliff_foot: 20, lone: 35 }),
    (id: "hazel", name: "Hazel", height_m: 5.0, spread_m: 10,
        habitats: { heart: 6, wood: 12, edge: 35, copse: 15, lone: 10 }),
    (id: "willow", name: "Willow", height_m: 12.0, spread_m: 24,
        habitats: { riverside: 100 }),
    (id: "wild_apple", name: "Wild apple", height_m: 6.0, spread_m: 14,
        habitats: { edge: 5, copse: 40, lone: 40 }),
    // Added on 9 November 2026 with the flora (content/flora.ron).
    (id: "alder", name: "Alder", height_m: 18.0, spread_m: 22,
        habitats: { riverside: 60, edge: 10 }),
    (id: "ash", name: "Ash", height_m: 28.0, big: true, spread_m: 26,
        habitats: { heart: 15, wood: 30, edge: 25, copse: 20 }),
    (id: "linden", name: "Linden", height_m: 25.0, big: true, spread_m: 18,
        habitats: { heart: 30, wood: 35, copse: 15 }),
    (id: "yew", name: "Yew", height_m: 12.0, spread_m: 12,
        habitats: { heart: 3, wood: 2 }),
]
