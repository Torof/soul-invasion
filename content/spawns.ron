// What lies on the ground when the valley is created (D15).
//
// material:     an id from materials.ron, quoted.
// terrain:      grass | forest | ford (water and rock hold nothing).
// per_thousand: pieces per thousand tiles of that terrain that satisfy
//               `near`, when given.
// near:         only within so many tiles (eight-way steps) of a terrain:
//               things lie where they come from.
//
// Hide, meat and bone come from animals; logs from felled trees: no rule.
[
    // Dead wood under the trees.
    (material: "branch", terrain: forest, per_thousand: 60),
    // Berry bushes at the forest's edge.
    (material: "berries", terrain: grass, per_thousand: 60, near: Some((terrain: forest, within: 2))),
    // Tall grass and reeds, thicker by the water.
    (material: "fibres", terrain: grass, per_thousand: 12),
    (material: "fibres", terrain: grass, per_thousand: 80, near: Some((terrain: water, within: 3))),
    // Pebbles on the banks and in the ford.
    (material: "pebble", terrain: grass, per_thousand: 90, near: Some((terrain: water, within: 4))),
    (material: "pebble", terrain: ford, per_thousand: 200),
    // Flint at the foot of the cliff.
    (material: "flint", terrain: grass, per_thousand: 70, near: Some((terrain: rock, within: 6))),
]
