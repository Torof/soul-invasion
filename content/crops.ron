// What the trees and plants bear to whoever gathers it, and when
// (docs/04-architecture.md D45; the values: content/ai-reserve/review/
// vivarium/nourriture.md, read by the project lead on 14 November 2026;
// its list taken whole on 16 November, but what hides an effect (D30):
// acorns, elder, plantain, fern, field mushroom, parasol and the deadly
// ones bear nothing here).
//
// A crop is worked out from the date, never stored: on any day a plant
// bears what its kind gives that season of that year, as far as it has
// ripened (`ripen`), less what men picked from it (the chunk's changes). What is not picked by its end is
// gone: fallen, eaten by the animals. Every number is a placeholder to
// tune by reading the vivarium's report.
//
// on:      the kind bearing it: a tree's id (species.ron) or a plant's
//          (flora.ron).
// gives:   the material (materials.ron). A kind gives a material once.
// from:    when it comes on the plant: (season, how far into it in
//          hundredths: 0 its first day, 100 its end).
// until:   when it is gone, the same way; before `from`, in the next year
//          (rose hips through the winter). (spring, 0) to (winter, 100):
//          all year.
// grams:   what one plant bears in a (lean, usual, rich) year of the
//          Earth, 365 days; each plant bears a share of its own, three
//          quarters to five quarters. In the game it bears that per cycle
//          of seasons × richness × the cycle's days ÷ 365 (D45, amended 24
//          November 2026, the calendar v1).
// years:   in a hundred years, how many are lean and how many rich; the
//          rest are usual. A kind has the same year over a kilometre of
//          the world, as the oaks of a country mast together.
// per_hour_g: what one person gathers of it by hand in an hour of work
//          (a 24th of the game day), while there is some on the plant.
// ripen:   how it comes and goes over its span (D48), in hundredths of
//          the span from `from` to `until`: (rise: R, fall: F), R + F at
//          most 100. On the plant: none at `from`, rising evenly to the
//          whole year's crop over the first R, the whole until the last
//          F, falling evenly to none at `until`. What can be picked on a
//          day is that share of the year's crop, less what was picked;
//          the load a plant shows follows it. Absent: (rise: 20, fall:
//          30). A crop there all year (roots, bulbs) neither rises nor
//          falls: (rise: 0, fall: 0).
// richness_permille: 7300 — the world's one dial on the land's yield, in
//          thousandths (D30 placeholder): 7.3 keeps the food of a game
//          day what it was with a 50-day cycle (7.3 × 50 ÷ 365 = 1); the
//          project lead fixes it after measuring.
(
    richness_permille: Some(7300),
    crops: [
        // The winter's store: 3 to 10 kg a tree, years of plenty and
        // lean years.
        (on: "hazel", gives: "hazelnuts", from: (autumn, 0), until: (winter, 0),
         grams: (1000, 5000, 10000), years: (lean: 25, rich: 25), per_hour_g: 2000),
        // A summer's end's fruit, 1 to 2 kg a bush, gone in days once
        // picked.
        (on: "bramble", gives: "blackberries", from: (summer, 60), until: (autumn, 60),
         grams: (500, 1500, 2000), years: (lean: 15, rich: 15), per_hour_g: 1000),
        // Spring, the renewal: leaves by the armful, roots, inner bark. A
        // rich season (the project lead, 16 November 2026): hunger kills
        // through predators and men later, not through spring.
        (on: "nettle", gives: "nettle_leaves", from: (spring, 0), until: (summer, 30),
         grams: (200, 400, 600), years: (lean: 10, rich: 10), per_hour_g: 1500),
        (on: "wild_garlic", gives: "garlic_leaves", from: (spring, 0), until: (spring, 100),
         grams: (60, 100, 160), years: (lean: 10, rich: 10), per_hour_g: 1500),
        (on: "dandelion", gives: "dandelion_leaves", from: (spring, 0), until: (summer, 50),
         grams: (100, 200, 300), years: (lean: 10, rich: 10), per_hour_g: 1500),
        (on: "watercress", gives: "watercress", from: (spring, 0), until: (autumn, 100),
         grams: (50, 100, 150), years: (lean: 10, rich: 10), per_hour_g: 600),
        (on: "linden", gives: "linden_leaves", from: (spring, 0), until: (spring, 100),
         grams: (600, 1200, 2000), years: (lean: 10, rich: 10), per_hour_g: 1500),
        (on: "pine", gives: "pine_bark", from: (spring, 0), until: (summer, 0),
         grams: (500, 800, 1200), years: (lean: 10, rich: 10), per_hour_g: 600),
        // Summer: the first fruits, peas, grain, the first mushrooms.
        (on: "wild_strawberry", gives: "strawberries", from: (summer, 0), until: (summer, 50),
         grams: (20, 50, 80), years: (lean: 15, rich: 15), per_hour_g: 300),
        (on: "raspberry", gives: "raspberries", from: (summer, 0), until: (summer, 100),
         grams: (200, 500, 700), years: (lean: 15, rich: 15), per_hour_g: 800),
        (on: "wild_pea", gives: "peas", from: (summer, 0), until: (summer, 100),
         grams: (20, 50, 100), years: (lean: 15, rich: 15), per_hour_g: 300),
        (on: "wild_cereal", gives: "grain", from: (summer, 60), until: (autumn, 30),
         grams: (30, 60, 100), years: (lean: 15, rich: 15), per_hour_g: 1000),
        (on: "chanterelle", gives: "chanterelles", from: (summer, 0), until: (autumn, 100),
         grams: (50, 150, 250), years: (lean: 30, rich: 20), per_hour_g: 600),
        // Autumn gives more than can be eaten.
        (on: "wild_apple", gives: "crab_apples", from: (summer, 70), until: (autumn, 100),
         grams: (10000, 20000, 30000), years: (lean: 20, rich: 20), per_hour_g: 4000),
        (on: "porcini", gives: "porcini", from: (summer, 60), until: (autumn, 100),
         grams: (100, 200, 400), years: (lean: 30, rich: 20), per_hour_g: 1000),
        (on: "wild_flax", gives: "flax_seeds", from: (summer, 60), until: (autumn, 30),
         grams: (10, 20, 40), years: (lean: 15, rich: 15), per_hour_g: 200),
        // Through the winter: haws and hips stay on the branch, oyster
        // mushrooms on the trunks, cattail roots in the mud all year.
        (on: "hawthorn", gives: "haws", from: (autumn, 0), until: (winter, 100),
         grams: (1000, 2000, 3000), years: (lean: 15, rich: 15), per_hour_g: 1000),
        (on: "dog_rose", gives: "rose_hips", from: (autumn, 0), until: (winter, 100),
         grams: (300, 700, 1000), years: (lean: 15, rich: 15), per_hour_g: 500),
        (on: "oyster_mushroom", gives: "oyster_mushrooms", from: (autumn, 30), until: (winter, 100),
         grams: (100, 300, 500), years: (lean: 20, rich: 20), per_hour_g: 800),
        (on: "cattail", gives: "cattail_root", from: (spring, 0), until: (winter, 100),
         grams: (1000, 1500, 2000), years: (lean: 5, rich: 5), per_hour_g: 1000,
         ripen: (rise: 0, fall: 0)),
        // More of the valley (16 November 2026). Spring: shoots and leaves.
        (on: "wild_asparagus", gives: "asparagus_shoots", from: (spring, 20), until: (spring, 100),
         grams: (50, 100, 150), years: (lean: 15, rich: 15), per_hour_g: 300),
        (on: "hop", gives: "hop_shoots", from: (spring, 0), until: (spring, 70),
         grams: (100, 200, 300), years: (lean: 10, rich: 10), per_hour_g: 800),
        (on: "sorrel", gives: "sorrel_leaves", from: (spring, 0), until: (summer, 60),
         grams: (50, 100, 200), years: (lean: 10, rich: 10), per_hour_g: 1000),
        (on: "chickweed", gives: "chickweed", from: (spring, 0), until: (autumn, 100),
         grams: (50, 100, 150), years: (lean: 10, rich: 10), per_hour_g: 800),
        // Lamb's lettuce from the winter's end to the spring's middle.
        (on: "lambs_lettuce", gives: "lambs_lettuce", from: (winter, 50), until: (spring, 60),
         grams: (30, 60, 100), years: (lean: 10, rich: 10), per_hour_g: 600),
        // The summer's start: currants, gooseberries, bilberries, greens.
        (on: "gooseberry", gives: "gooseberries", from: (spring, 90), until: (summer, 60),
         grams: (1000, 2000, 3000), years: (lean: 15, rich: 15), per_hour_g: 1500),
        (on: "red_currant", gives: "red_currants", from: (summer, 0), until: (summer, 60),
         grams: (500, 1500, 2500), years: (lean: 15, rich: 15), per_hour_g: 1200),
        (on: "blackcurrant", gives: "blackcurrants", from: (summer, 10), until: (summer, 70),
         grams: (500, 1200, 2000), years: (lean: 15, rich: 15), per_hour_g: 1000),
        (on: "bilberry", gives: "bilberries", from: (summer, 20), until: (summer, 100),
         grams: (100, 250, 400), years: (lean: 20, rich: 20), per_hour_g: 600),
        (on: "purslane", gives: "purslane", from: (summer, 0), until: (autumn, 30),
         grams: (50, 150, 250), years: (lean: 10, rich: 10), per_hour_g: 1000),
        (on: "fat_hen", gives: "fat_hen_leaves", from: (spring, 60), until: (autumn, 30),
         grams: (100, 250, 400), years: (lean: 10, rich: 10), per_hour_g: 1500),
        // Late fruits, and what holds through the winter: sloes on the
        // branch, roots and bulbs, tubers in the mud and the water.
        (on: "cornelian_cherry", gives: "cornels", from: (summer, 70), until: (autumn, 60),
         grams: (2000, 5000, 8000), years: (lean: 20, rich: 20), per_hour_g: 2000),
        (on: "wild_grape", gives: "grapes", from: (autumn, 0), until: (autumn, 70),
         grams: (1000, 3000, 5000), years: (lean: 20, rich: 20), per_hour_g: 2000),
        (on: "strawberry_tree", gives: "arbutus_berries", from: (autumn, 50), until: (winter, 60),
         grams: (1000, 3000, 5000), years: (lean: 20, rich: 20), per_hour_g: 1500),
        (on: "blackthorn", gives: "sloes", from: (autumn, 50), until: (winter, 100),
         grams: (1000, 2000, 3000), years: (lean: 15, rich: 15), per_hour_g: 1200),
        (on: "wild_onion", gives: "wild_onions", from: (spring, 0), until: (winter, 100),
         grams: (20, 40, 60), years: (lean: 5, rich: 5), per_hour_g: 300,
         ripen: (rise: 0, fall: 0)),
        (on: "silverweed", gives: "silverweed_root", from: (autumn, 0), until: (spring, 30),
         grams: (30, 60, 100), years: (lean: 10, rich: 10), per_hour_g: 400),
        (on: "arrowhead", gives: "arrowhead_tubers", from: (autumn, 30), until: (spring, 40),
         grams: (50, 100, 150), years: (lean: 10, rich: 10), per_hour_g: 500),
        (on: "water_chestnut", gives: "water_chestnuts", from: (autumn, 0), until: (winter, 50),
         grams: (50, 150, 250), years: (lean: 15, rich: 15), per_hour_g: 800),
        // The fruit and nut trees (16 November 2026): cherries and
        // mulberries for the summer, pears, figs, walnuts and chestnuts for
        // the autumn and the winter's store.
        (on: "wild_cherry", gives: "cherries", from: (summer, 0), until: (summer, 40),
         grams: (5000, 15000, 30000), years: (lean: 25, rich: 20), per_hour_g: 3000),
        (on: "mulberry", gives: "mulberries", from: (summer, 20), until: (summer, 80),
         grams: (3000, 8000, 15000), years: (lean: 15, rich: 15), per_hour_g: 2500),
        (on: "wild_fig", gives: "figs", from: (summer, 60), until: (autumn, 50),
         grams: (2000, 6000, 12000), years: (lean: 20, rich: 15), per_hour_g: 2500),
        (on: "wild_pear", gives: "pears", from: (autumn, 0), until: (autumn, 80),
         grams: (5000, 15000, 25000), years: (lean: 20, rich: 20), per_hour_g: 4000),
        (on: "walnut", gives: "walnuts", from: (autumn, 20), until: (winter, 30),
         grams: (5000, 15000, 30000), years: (lean: 25, rich: 25), per_hour_g: 2000),
        (on: "chestnut", gives: "chestnuts", from: (autumn, 20), until: (winter, 20),
         grams: (10000, 30000, 60000), years: (lean: 25, rich: 25), per_hour_g: 3000),
    ],
)
