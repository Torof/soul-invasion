// What the trees and plants bear to whoever gathers it, and when
// (docs/04-architecture.md D45; the values: content/ai-reserve/review/
// vivarium/nourriture.md, read by the project lead on 14 November 2026;
// its list taken whole on 16 November, but what hides an effect (D30):
// acorns, elder, plantain, fern, field mushroom, parasol and the deadly
// ones bear nothing here).
//
// A crop is worked out from the date, never stored: on any day a plant
// bears what its kind gives that season of that year, less what men
// picked from it (the chunk's changes). What is not picked by its end is
// gone: fallen, eaten by the animals. Every number is a placeholder to
// tune by reading the vivarium's report.
//
// on:      the kind bearing it: a tree's id (species.ron) or a plant's
//          (flora.ron).
// gives:   the material (materials.ron). A kind gives a material once.
// from:    when it comes on the plant: (season, how far into it in
//          hundredths: 0 its first day, 100 its end).
// until:   when it is gone, the same way; before `from`, in the next year
//          (rose hips through the winter). (spring, 0) to (winter, 100):
//          all year.
// grams:   what one plant bears in a (lean, usual, rich) year; each plant
//          bears a share of its own, three quarters to five quarters.
// years:   in a hundred years, how many are lean and how many rich; the
//          rest are usual. A kind has the same year over a kilometre of
//          the world, as the oaks of a country mast together.
// per_hour_g: what one person gathers of it by hand in an hour of work
//          (a 24th of the game day), while there is some on the plant.
(
    crops: [
        // The winter's store: 3 to 10 kg a tree, years of plenty and
        // lean years.
        (on: "hazel", gives: "hazelnuts", from: (autumn, 0), until: (winter, 0),
         grams: (1000, 5000, 10000), years: (lean: 25, rich: 25), per_hour_g: 2000),
        // A summer's end's fruit, 1 to 2 kg a bush, gone in days once
        // picked.
        (on: "bramble", gives: "blackberries", from: (summer, 60), until: (autumn, 60),
         grams: (500, 1500, 2000), years: (lean: 15, rich: 15), per_hour_g: 1000),
        // Spring, the season of hunger: leaves, worth little.
        (on: "nettle", gives: "nettle_leaves", from: (spring, 0), until: (summer, 30),
         grams: (100, 200, 300), years: (lean: 10, rich: 10), per_hour_g: 1000),
        (on: "wild_garlic", gives: "garlic_leaves", from: (spring, 0), until: (spring, 100),
         grams: (30, 50, 80), years: (lean: 10, rich: 10), per_hour_g: 600),
        (on: "dandelion", gives: "dandelion_leaves", from: (spring, 0), until: (summer, 50),
         grams: (50, 100, 150), years: (lean: 10, rich: 10), per_hour_g: 500),
        (on: "watercress", gives: "watercress", from: (spring, 0), until: (autumn, 100),
         grams: (50, 100, 150), years: (lean: 10, rich: 10), per_hour_g: 600),
        (on: "linden", gives: "linden_leaves", from: (spring, 0), until: (spring, 100),
         grams: (300, 600, 1000), years: (lean: 10, rich: 10), per_hour_g: 800),
        // Summer: the first fruits, peas, grain, the first mushrooms.
        (on: "wild_strawberry", gives: "strawberries", from: (summer, 0), until: (summer, 50),
         grams: (20, 50, 80), years: (lean: 15, rich: 15), per_hour_g: 300),
        (on: "raspberry", gives: "raspberries", from: (summer, 0), until: (summer, 100),
         grams: (200, 500, 700), years: (lean: 15, rich: 15), per_hour_g: 800),
        (on: "wild_pea", gives: "peas", from: (summer, 0), until: (summer, 100),
         grams: (20, 50, 100), years: (lean: 15, rich: 15), per_hour_g: 300),
        (on: "wild_cereal", gives: "grain", from: (summer, 60), until: (autumn, 30),
         grams: (30, 60, 100), years: (lean: 15, rich: 15), per_hour_g: 1000),
        (on: "chanterelle", gives: "chanterelles", from: (summer, 0), until: (autumn, 100),
         grams: (50, 150, 250), years: (lean: 30, rich: 20), per_hour_g: 600),
        // Autumn gives more than can be eaten.
        (on: "wild_apple", gives: "crab_apples", from: (summer, 70), until: (autumn, 100),
         grams: (10000, 20000, 30000), years: (lean: 20, rich: 20), per_hour_g: 4000),
        (on: "porcini", gives: "porcini", from: (summer, 60), until: (autumn, 100),
         grams: (100, 200, 400), years: (lean: 30, rich: 20), per_hour_g: 1000),
        (on: "wild_flax", gives: "flax_seeds", from: (summer, 60), until: (autumn, 30),
         grams: (10, 20, 40), years: (lean: 15, rich: 15), per_hour_g: 200),
        // Through the winter: haws and hips stay on the branch, oyster
        // mushrooms on the trunks, cattail roots in the mud all year.
        (on: "hawthorn", gives: "haws", from: (autumn, 0), until: (winter, 100),
         grams: (1000, 2000, 3000), years: (lean: 15, rich: 15), per_hour_g: 1000),
        (on: "dog_rose", gives: "rose_hips", from: (autumn, 0), until: (winter, 100),
         grams: (300, 700, 1000), years: (lean: 15, rich: 15), per_hour_g: 500),
        (on: "oyster_mushroom", gives: "oyster_mushrooms", from: (autumn, 30), until: (winter, 100),
         grams: (100, 300, 500), years: (lean: 20, rich: 20), per_hour_g: 800),
        (on: "cattail", gives: "cattail_root", from: (spring, 0), until: (winter, 100),
         grams: (300, 400, 500), years: (lean: 5, rich: 5), per_hour_g: 500),
    ],
)
