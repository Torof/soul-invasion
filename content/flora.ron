            gives: ["garlic_leaves"], season: "spring"),
        (id: "plantain", name: "Plantain", height_m: 0.2,
            habitats: { "meadow": 30, "camp": 40, "edge": 20 }, moisture: (10, 80), light: (50, 100),
            grouping: carpet(0.9), per_thousand: 4,
            gives: ["plantain_leaves"], season: "spring to autumn"),
        (id: "fern", name: "Fern", height_m: 0.8,
            habitats: { "wood": 60, "heart": 50, "edge": 10 }, moisture: (40, 90), light: (0, 50),
            grouping: carpet(3.0), per_thousand: 10,
            gives: ["fern_fronds"], season: "spring to autumn"),
        (id: "wild_flax", name: "Wild flax", height_m: 0.6,
            habitats: { "meadow": 40 }, moisture: (20, 60), light: (80, 100),
            grouping: clump(2.0), per_thousand: 2,
            gives: ["flax_stems", "flax_seeds"], season: "summer"),
        (id: "dandelion", name: "Dandelion", height_m: 0.2,
            habitats: { "meadow": 50, "camp": 30, "edge": 20 }, moisture: (10, 80), light: (60, 100),
            grouping: carpet(0.9), per_thousand: 5,
            gives: ["dandelion_leaves", "dandelion_root"], season: "spring to autumn"),
        (id: "water_mint", name: "Water mint", height_m: 0.4,
            habitats: { "bank": 60, "stream": 20 }, moisture: (80, 100), light: (40, 100),
            grouping: clump(1.5), per_thousand: 5,
            gives: ["mint_leaves"], season: "summer"),
        (id: "yarrow", name: "Yarrow", height_m: 0.5,
            habitats: { "meadow": 50, "edge": 10 }, moisture: (10, 50), light: (70, 100),
            grouping: carpet(0.8), per_thousand: 2,
            gives: ["yarrow"], season: "summer"),
        (id: "watercress", name: "Watercress", height_m: 0.2,
            habitats: { "stream": 80, "shallows": 20 }, moisture: (95, 100), light: (40, 100),
            grouping: carpet(1.5), per_thousand: 30,
            gives: ["watercress"], season: "spring to autumn"),
        (id: "woad", name: "Woad", height_m: 0.9,
            habitats: { "meadow": 20, "edge": 10 }, moisture: (10, 50), light: (80, 100),
            grouping: clump(1.5), per_thousand: 1,
            gives: ["woad_leaves"], season: "summer"),
        // More of the valley's food (16 November 2026): spring shoots and
        // leaves, summer greens, roots and bulbs for the cold months, and
        // tubers in the water. Burdock is left out: its root is mistaken
        // for deadly nightshade's.
        (id: "wild_asparagus", name: "Wild asparagus", height_m: 0.8,
            habitats: { "edge": 40, "meadow": 20 }, moisture: (10, 60), light: (50, 100),
            grouping: clump(1.0), per_thousand: 2,
            gives: ["asparagus_shoots"], season: "spring"),
        (id: "hop", name: "Hop", height_m: 3.0,
            habitats: { "bank": 40, "edge": 40 }, moisture: (50, 90), light: (40, 100),
            grouping: clump(1.5), per_thousand: 3,
            gives: ["hop_shoots", "fibres"], season: "spring"),
        (id: "sorrel", name: "Sorrel", height_m: 0.4,
            habitats: { "meadow": 50, "edge": 20 }, moisture: (30, 80), light: (60, 100),
            grouping: carpet(1.0), per_thousand: 4,
            gives: ["sorrel_leaves"], season: "spring, summer"),
        (id: "lambs_lettuce", name: "Lamb's lettuce", height_m: 0.1,
            habitats: { "meadow": 30, "edge": 20, "camp": 20 }, moisture: (20, 70), light: (50, 100),
            grouping: carpet(0.8), per_thousand: 3,
            gives: ["lambs_lettuce"], season: "late winter, spring"),
        (id: "chickweed", name: "Chickweed", height_m: 0.1,
            habitats: { "camp": 50, "edge": 20, "clearing": 20 }, moisture: (30, 80), light: (30, 100),
            grouping: carpet(1.0), per_thousand: 5,
            gives: ["chickweed"], season: "spring to autumn"),
        (id: "purslane", name: "Purslane", height_m: 0.1,
            habitats: { "camp": 40, "meadow": 20, "edge": 10 }, moisture: (10, 60), light: (70, 100),
            grouping: carpet(0.8), per_thousand: 3,
            gives: ["purslane"], season: "summer"),
        (id: "fat_hen", name: "Fat hen", height_m: 0.8,
            habitats: { "camp": 60, "clearing": 20, "edge": 10 }, moisture: (20, 70), light: (60, 100),
            grouping: clump(1.5), per_thousand: 4,
            gives: ["fat_hen_leaves"], season: "late spring to autumn"),
        (id: "wild_onion", name: "Wild onion", height_m: 0.5,
            habitats: { "meadow": 40, "edge": 20 }, moisture: (20, 60), light: (60, 100),
