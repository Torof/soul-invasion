    // Barks (D57): cut from a tree with an edge keen enough in hand, each
    // as its tree makes it. Birch bark is the one the project lead saw
    // found on 24 November 2026 ("C'est parfait"); since 27 November 2026
    // nothing says what it folds into: supple, a sheet of it takes a
    // hollow. Folded, it lasts two seasons (32 days in calendar v1; the
    // project lead, 26 November 2026: a cycle was too long, a box remade
    // more often is practised more; it tore in one season, then lasted
    // four). Oak bark is thick, hard and stiff; pine bark comes away in
    // crumbly plates. Placeholder values.
    (id: "birch_bark", name: "Birch bark",
     description: "A sheet of bark cut from a birch, thin, supple and waterproof.",
     kind: plant, mass_kg: 0.2, hardness: 1, suppleness: 7, toughness: 5,
     form: sheet, area_dm2: 16, wears_seasons: 2,
     flammable: true, food: None, look: (colour: "#e8e2d0")),
    (id: "oak_bark", name: "Oak bark",
     description: "A thick slab of bark cut from an oak, rough, hard and stiff.",
     kind: plant, mass_kg: 0.8, hardness: 3, suppleness: 1, toughness: 6,
     form: sheet, area_dm2: 16,
     flammable: true, food: None, look: (colour: "#6a5a48")),
    (id: "pine_outer_bark", name: "Pine bark",
     description: "A plate of the scaly outer bark of a pine, light and crumbly.",
     kind: plant, mass_kg: 0.4, hardness: 2, suppleness: 1, toughness: 2,
     form: sheet, area_dm2: 9,
     flammable: true, food: None, look: (colour: "#8a5a3a")),
    // A big leaf (27 November 2026): butterbur grows on the banks, its
    // leaves as wide as a forearm is long. Limp and thin, it tears within
    // a day of being folded.
    (id: "butterbur_leaf", name: "Butterbur leaf",
     description: "A very big, limp leaf from the river bank, thin and soon torn.",
     kind: plant, mass_kg: 0.05, hardness: 0, suppleness: 9, toughness: 1,
     form: sheet, area_dm2: 9, wears_days: 1,
     flammable: false, food: None, look: (colour: "#5a8a4a")),
    // The flint as the ground gives it (D57, amended 27 November 2026): a
    // rounded nodule in its chalky rind, with no edge to speak of. Struck
    // with a tougher stone, keen flint breaks off it, piece after piece.
    (id: "flint_nodule", name: "Flint nodule",
     description: "A rounded lump of flint in a pale rind, heavy in the hand.",
     kind: stone, mass_kg: 1.2, hardness: 7, edge: 2, toughness: 5,
     breaks_into: Some("flint"),
     flammable: false, food: None, look: (colour: "#8a857a")),
    // A tree in parts (D57, amended 27 November 2026). Living wood is its
    // own stuff: softer under an edge than dead wood, wet, more supple
    // and tougher (a green branch bends where a dead one snaps). A piece
    // is a branch as thick as a wrist, cut off a standing tree. Chips are
    // what falls from a trunk an edge bites: bits of wood. Placeholders,
    // meant plausible for the stuff, none chosen for a use.
    (id: "green_branch", name: "Green branch",
     description: "A branch cut from a living tree, heavy with sap, that bends before it breaks.",
     kind: wood, mass_kg: 2.0, hardness: 2, suppleness: 5, toughness: 6, form: stick,
     flammable: false, food: None, look: (colour: "#6a7a4a")),
    (id: "wood_chips", name: "Wood chips",
     description: "Chips of fresh wood fallen from a cut trunk.",
     kind: wood, mass_kg: 0.05, hardness: 2, form: bits,
     flammable: true, food: None, look: (colour: "#d8c8a0")),
