// Materials of the valley (D15). Placeholder values, tuned by play.
//
// id:          snake_case, unique; the name objects and rules refer to.
// name:        shown to players.
// description: one sentence shown to players, what it is and what it is for.
// kind:        stone | wood | plant | animal.
// mass_kg:     one piece as the ground drops it; an item then keeps its own
//              grams, split and merged (D35).
// hardness:    0 (soft) to 10 (hardest); knapping and cutting compare it.
// flammable:   feeds a fire.
// food:        None, or (energy_kj_per_kg, keeps_days or keeps_seasons):
//              the energy of a kilogram on the one scale all content
//              shares (D15), and how long it keeps untreated: a short
//              keeping in days, a long one in seasons, so that it follows
//              the calendar when the calendar is tuned (D09); never both.
//              Nuts, wild grain, peas and seeds keep a cycle of the
//              four seasons at least (keeps_seasons: 4, 64 days in
//              calendar v1; the project lead, 24 November 2026): autumn's
//              food lasts to spring. Walnuts keep six seasons, a cycle
//              and a half (96 days in calendar v1; 90 days until 25
//              November 2026, the nearest whole seasons).
//              Hazelnuts and walnuts are weighed in their shells, as
//              the crops give them: 11,500 kJ a kilogram, not the
//              kernel's 26,000 (the plants' weight, 24 November 2026).
// look:        provisional graphics, a colour.
// What a material is, for the gestures of the hands (D57, amended 27
// November 2026): scales every material has a value on (0 when absent),
// which say what the stuff is, never what it is for. What a gesture gives
// is computed from them, and may be nothing, or the thing broken.
// edge:        how keen its edge is, 0 (none) to 10. A thing worked with
//              it comes away when the edge is at least as keen as that
//              thing is tough, and the stuff harder (hardness, above).
// suppleness:  how far it bends before it breaks, 0 (not at all) to 10.
// toughness:   how it holds together against an edge, a tear, a
//              crumbling, 0 (falls apart) to 10.
// form:        the shape of a piece: block (a lump, the default) | sheet
//              (flat and wide) | stick (long and stiff) | strand (long
//              and limp) | bits (many small things together).
// area_dm2:    a sheet's face, in square decimetres. Folded, a sheet
//              supple enough (needs.ron, hands.fold_suppleness) takes a
//              hollow, the open box a square of that face folds into
//              (2/27 of its side cubed: 4.7 litres for 16 dm2); a stiffer
//              sheet breaks and is lost; what is no sheet does nothing.
//              A hollow keeps loose food together, by its litres
//              (hands.loose_g_per_litre), on top of what the arms hold.
// wears_days:  days after it was folded that it tears at its folds and
//              is gone; or
// wears_seasons: the same in seasons, for a long wear (D09); never both.
// The values are placeholders, meant plausible for the stuff, none chosen
// for what the people might make of it.
[
    (id: "flint", name: "Flint",
     description: "A hard stone that flakes to a sharp edge when struck.",
     kind: stone, mass_kg: 0.4, hardness: 7, edge: 9, toughness: 5,
     flammable: false, food: None, look: (colour: "#5e5a52")),
    (id: "pebble", name: "Pebble",
     description: "A smooth river stone, good for hammering.",
     kind: stone, mass_kg: 0.6, hardness: 6, edge: 1, toughness: 8,
     flammable: false, food: None, look: (colour: "#9a948a")),
    // More stones (D57, amended 27 November 2026): what else lies in the
    // gravels and under the rock, each with its own hardness and edge.
    (id: "quartz", name: "Quartz",
     description: "A broken piece of white quartz, hard, with an uneven edge.",
     kind: stone, mass_kg: 0.4, hardness: 7, edge: 5, toughness: 6,
     flammable: false, food: None, look: (colour: "#d8d4cc")),
    (id: "slate", name: "Slate",
     description: "A thin plate of slate, soft for a stone; its rim is fine and chips.",
     kind: stone, mass_kg: 0.5, hardness: 3, edge: 4, toughness: 3,
     flammable: false, food: None, look: (colour: "#4a5058")),
    (id: "sandstone", name: "Sandstone",
     description: "A grainy block of sandstone that sheds sand when rubbed.",
     kind: stone, mass_kg: 0.8, hardness: 4, toughness: 2,
     flammable: false, food: None, look: (colour: "#c2a878")),
    (id: "branch", name: "Branch",
     description: "Dead wood, dry enough to burn or to be worked.",
     kind: wood, mass_kg: 1.5, hardness: 3, suppleness: 2, toughness: 5, form: stick,
     flammable: true, food: None, look: (colour: "#7a5a3a")),
    (id: "log", name: "Log",
     description: "A felled trunk, too heavy to carry alone.",
     kind: wood, mass_kg: 25.0, hardness: 3, toughness: 7, form: stick,
     flammable: true, food: None, look: (colour: "#5a3e24")),
    (id: "fibres", name: "Fibres",
     description: "Tough plant fibres, twisted into cordage.",
     kind: plant, mass_kg: 0.2, hardness: 1, suppleness: 9, toughness: 6, form: strand,
     flammable: true, food: None, look: (colour: "#b8b06a")),
    (id: "berries", name: "Berries",
     description: "A handful of ripe berries. They spoil in days.",
     kind: plant, mass_kg: 0.1, hardness: 0, form: bits,
     flammable: false, food: Some((energy_kj_per_kg: 2500, keeps_days: 3)), look: (colour: "#8a2a5a")),
    (id: "hazelnuts", name: "Hazelnuts",
