// How a body hungers, freezes, tires and dies (D34). Placeholder values,
// tuned by play. Every rate is in points of a 0–100 gauge per game day.
//
// night_from_percent:      the day starts at dawn; night begins here, by
//                          season (D09): the light lasts longer in summer.
//                          Of a 24 h day from 06:00: spring and autumn 58 %
//                          (night at 19:55), summer 64 % (21:20), winter
//                          56 % (19:25). Winter is shortened only that much
//                          until cold by season, fire and shelter come: its
//                          10.6 h of night cost a body sleeping outside 43
//                          points of vitality, which the day gives back; at
//                          50 % it would lose 25 a day and die in winter.
// hunger_per_day:          100 — with kj_per_hunger_point, a body burns
//                          10,000 kJ a day, out of its fat reserve; hunger
//                          is the appetite, what the reserve misses and
//                          can still be eaten today (lot 3).
// thirst_per_day:          100 — a game day without drinking fills it
//                          (D34, 13 November 2026), in the cool of spring,
//                          at rest.
// thirst_heat_percent:     the same, by season: a summer's day dries
//                          faster, a winter's slower (lot 2, D45).
// thirst_effort_percent:   150 — walking or working, thirst comes half as
//                          fast again.
// cold_per_day_at_night:   300 — eight hours of night without warmth.
// cold_relief_per_day:     600 — four hours of daylight undo it.
// fatigue_per_day_awake:   120 — twenty hours awake fill the gauge.
// rest_per_day_asleep:     300 — eight hours of sleep empty it.
// starving_per_day:        100 — once the reserve is spent, a day kills
//                          (lot 3, 16 November 2026).
// freezing_per_day:        400 — six hours at full cold kill: a summer
//                          night outside hurts but does not kill.
// dehydration_per_day:     50 — two days at full thirst kill: a body dies
//                          on the third day without water, as people do.
// vitality_regain_per_day: 50 — two days fed, warm and rested to heal.
// kj_per_hunger_point:     100 — the gauge is a day's 10,000 kJ: a meal of
//                          hazelnuts (300 g, 7,800 kJ) relieves 78 points,
//                          a handful of berries (100 g, 250 kJ) 2.
// meal_g:                  300 — grams eaten at most in one act; the rest
//                          of the item stays (D35).
// reserve_kj:              60000 — six days of need: without food a body
//                          is thin on the third day, weak near the fifth,
//                          its reserve spent on the sixth, dead on the
//                          seventh (lot 3, decided 16 November 2026).
// intake_ceiling_percent:  150 — a day's eating, in percent of the need:
//                          a spent reserve takes twelve days to make again.
// thin_percent:            50 — thin under half its reserve.
// weak_percent:            20 — weak under a fifth: it walks and gathers
// weak_pace_percent:       70 — at seven tenths of its pace.
(
    night_from_percent: (spring: 58, summer: 64, autumn: 58, winter: 56),
    hunger_per_day: 100,
    thirst_per_day: 100,
    thirst_heat_percent: (spring: 100, summer: 140, autumn: 100, winter: 80),
    thirst_effort_percent: 150,
    cold_per_day_at_night: 300,
    cold_relief_per_day: 600,
    fatigue_per_day_awake: 120,
    rest_per_day_asleep: 300,
    starving_per_day: 100,
    freezing_per_day: 400,
    dehydration_per_day: 50,
    vitality_regain_per_day: 50,
    kj_per_hunger_point: 100,
    meal_g: 300,
    reserve_kj: 60000,
    intake_ceiling_percent: 150,
    thin_percent: 50,
    weak_percent: 20,
    weak_pace_percent: 70,
    // Ages and sexes (lot 3 B, decided by the project lead on 17 November
    // 2026), in game years. A body's need, its reserve, its day's ceiling
    // and what it carries go with its size: an infant 30 % of a grown
    // man, a child 40 % at two to 90 % at fourteen, a man 100 %, past
    // fifty-five 85 %; a woman 85 % of a man of her age. A woman nursing
    // needs 25 % more, and her infant burns nothing of its own; weaned at
    // two, it walks and gathers for itself. Children under twelve and the
    // old past fifty-five go at 70 % of the pace. An infant weighs 3.5 kg
    // at birth, 12 kg weaned, on whoever carries it; an orphan is taken by
    // the nearest woman within 64 tiles.
    ages: (
        need_by_age: [(0, 30), (2, 40), (14, 90), (18, 100), (55, 100), (56, 85)],
        woman_percent: 85,
        woman_from_years: 14,
        nursing_percent: 125,
        weaned_years: 2,
        slow_under_years: 12,
        slow_over_years: 55,
        slow_pace_percent: 70,
        infant_mass_g: (3500, 12000),
        adopt_within_tiles: 64,
    ),
)
